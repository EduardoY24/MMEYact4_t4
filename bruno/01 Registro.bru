meta {
  name: 01 Registro
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Eduardo",
    "email": "eduardo@correo.com",
    "password": "123456"
  }
}

script:post-response {
  if (res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}
